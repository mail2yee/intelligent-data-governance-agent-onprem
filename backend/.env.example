# Copy to .env and fill in real values. Never commit the real .env.

# Postgres
DATABASE_URL=postgresql+asyncpg://dgo:dgo@localhost:5432/dgo

# On-prem LLM gateway. Assumed OpenAI-compatible (POST {LLM_BASE_URL}/chat/completions,
# stream=true) - confirmed this shape works for real against a local
# Ollama (LLM_BASE_URL=http://host.docker.internal:11434/v1 from inside
# the Docker container, LLM_MODEL=<any locally-pulled model name>, no
# LLM_API_KEY needed) - but the *company's actual* on-prem gateway is a
# different, still-unconfirmed endpoint. **Set these three to the real
# company gateway's values to actually use it** - if its shape differs
# from OpenAI-compatible chat completions, adjust
# backend/app/integrations/llm_client.py.
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=gemma
LLM_API_KEY=
# Optional: a separate, tool-calling/structured-output-tuned model used
# only for chat.py's SQL-generation step (resolve_via_semantic_layer) -
# leave blank to use LLM_MODEL for everything. Confirmed useful in local
# testing: general chat models (e.g. qwen2.5) are noticeably less
# reliable than a tool-calling-tuned model at writing valid, well-formed
# SQL for this step. If the company gateway only exposes one model,
# leave this blank - there's nothing to split against.
LLM_SQL_MODEL=

# On-prem Camunda 8 (self-managed) Zeebe gateway - see
# backend/app/integrations/camunda_client.py. No BPMN process is deployed
# yet, so CAMUNDA_PROCESS_ID is a placeholder; deploy one and update it
# here once ready (no code change needed).
CAMUNDA_GATEWAY_ADDRESS=localhost:26500
CAMUNDA_PROCESS_ID=data-gov-approval
# Leave the three below blank to use an unauthenticated channel (confirmed
# OK for now). Fill in all three to use OAuth2 client-credentials instead -
# this path is untested against a live Camunda Identity/Keycloak instance.
CAMUNDA_OAUTH_CLIENT_ID=
CAMUNDA_OAUTH_CLIENT_SECRET=
CAMUNDA_OAUTH_TOKEN_URL=
CAMUNDA_OAUTH_AUDIENCE=zeebe-api

# DataHub metadata catalog - see backend/app/integrations/datahub_client.py.
# GraphQL endpoint is {DATAHUB_API_URL}/api/graphql, auth is a personal
# access token as an Authorization: Bearer header. Falls back to a
# hardcoded mock catalog if unreachable/unset.
DATAHUB_API_URL=http://localhost:8080
DATAHUB_API_TOKEN=

# WrenAI semantic layer (see backend/app/integrations/wrenai_client.py
# and ../wren/project) - zero-hallucination data-subject matching for
# chat.py. Default is correct for local dev (run from within backend/,
# so ../wren/project resolves to the repo-root wren/ directory); the
# Docker image overrides this to /app/wren_project via docker-compose.yml.
WREN_PROJECT_PATH=../wren/project

# Comma-separated list of origins allowed to call this API (React dev
# server, etc.)
CORS_ORIGINS=http://localhost:5173

# Comma-separated fallback approver emails used to pad a ticket's approver
# list up to 3 when the requested products' own owners don't provide that
# many (see main.py create_ticket / config.py docstring).
DEFAULT_FALLBACK_APPROVERS=compliance_director@example.com,info_sec_auditor@example.com
