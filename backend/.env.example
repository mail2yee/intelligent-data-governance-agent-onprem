# Copy to .env and fill in real values. Never commit the real .env.

# Postgres
DATABASE_URL=postgresql+asyncpg://dgo:dgo@localhost:5432/dgo

# On-prem LLM gateway. Assumed OpenAI-compatible (POST {LLM_BASE_URL}/chat/completions,
# stream=true) - unconfirmed against the real endpoint, adjust
# backend/app/integrations/llm_client.py if the real shape differs.
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=gemma
LLM_API_KEY=

# On-prem Camunda 8 (self-managed) Zeebe gateway - see
# backend/app/integrations/camunda_client.py. No BPMN process is deployed
# yet, so CAMUNDA_PROCESS_ID is a placeholder; deploy one and update it
# here once ready (no code change needed).
CAMUNDA_GATEWAY_ADDRESS=localhost:26500
CAMUNDA_PROCESS_ID=data-gov-approval
# Leave the three below blank to use an unauthenticated channel (confirmed
# OK for now). Fill in all three to use OAuth2 client-credentials instead -
# this path is untested against a live Camunda Identity/Keycloak instance.
CAMUNDA_OAUTH_CLIENT_ID=
CAMUNDA_OAUTH_CLIENT_SECRET=
CAMUNDA_OAUTH_TOKEN_URL=
CAMUNDA_OAUTH_AUDIENCE=zeebe-api

# DataHub metadata catalog - see backend/app/integrations/datahub_client.py.
# GraphQL endpoint is {DATAHUB_API_URL}/api/graphql, auth is a personal
# access token as an Authorization: Bearer header. Falls back to a
# hardcoded mock catalog if unreachable/unset.
DATAHUB_API_URL=http://localhost:8080
DATAHUB_API_TOKEN=

# Comma-separated list of origins allowed to call this API (React dev
# server, etc.)
CORS_ORIGINS=http://localhost:5173
