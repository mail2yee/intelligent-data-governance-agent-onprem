# Copy to .env and fill in real values. Never commit the real .env.

# Postgres
DATABASE_URL=postgresql+asyncpg://dgo:dgo@localhost:5432/dgo

# On-prem LLM gateway. Assumed OpenAI-compatible (POST {LLM_BASE_URL}/chat/completions,
# stream=true) - confirmed this shape works for real against a local
# Ollama (LLM_BASE_URL=http://host.docker.internal:11434/v1 from inside
# the Docker container, LLM_MODEL=<any locally-pulled model name>, no
# LLM_API_KEY needed) - but the *company's actual* on-prem gateway is a
# different, still-unconfirmed endpoint. **Set these three to the real
# company gateway's values to actually use it** - if its shape differs
# from OpenAI-compatible chat completions, adjust
# backend/app/integrations/llm_client.py.
LLM_BASE_URL=http://localhost:8001/v1
# qwen3 is the model actually used for local dev/testing in this project
# (see backend/.env) - swap to whatever the real company gateway serves.
LLM_MODEL=qwen3
LLM_API_KEY=
# Optional: a separate, tool-calling/structured-output-tuned model used
# only for chat.py's SQL-generation step (resolve_via_semantic_layer) -
# leave blank to use LLM_MODEL for everything. Confirmed useful in local
# testing: general chat models (e.g. qwen2.5) are noticeably less
# reliable than a tool-calling-tuned model at writing valid, well-formed
# SQL for this step. If the company gateway only exposes one model,
# leave this blank - there's nothing to split against.
LLM_SQL_MODEL=

# On-prem Camunda 7 (self-managed) REST API - see
# backend/app/integrations/camunda_client.py and
# camunda/data-gov-approval.bpmn (the process this app deploys itself on
# startup, see entrypoint.sh). Confirmed 2026-07-29 the company's real
# instance is Camunda **7.22** - REST API, not the gRPC-based Camunda
# 8/Zeebe originally (incorrectly) assumed.
# This value only actually matters when Camunda ISN'T self-hosted -
# docker-compose.camunda.yml overrides it to http://camunda:8080/engine-rest
# whenever that overlay is included (deploy.sh's default local-dev
# behavior). Two cases where it's live:
#   - Running the backend outside Docker against the compose-hosted
#     Camunda: http://localhost:8082/engine-rest (8082 is the
#     host-mapped port).
#   - ./deploy.sh --office (see deploy.sh's header comment and
#     HANDOFF.md's "Office mode" section) - Camunda is NEVER
#     self-hosted in this mode, so whatever's here IS what the app
#     talks to. Point it at the company's real Camunda 7.22 instance.
CAMUNDA_BASE_URL=http://localhost:8082/engine-rest
CAMUNDA_PROCESS_DEFINITION_KEY=data-gov-approval
# Leave both blank to use Camunda unauthenticated (confirmed OK against
# camunda/camunda-bpm-platform:7.22.0's defaults). Fill in both to use
# HTTP Basic auth instead, if the company's real instance requires it
# (unconfirmed against that instance).
CAMUNDA_BASIC_AUTH_USERNAME=
CAMUNDA_BASIC_AUTH_PASSWORD=

# DataHub metadata catalog - see backend/app/integrations/datahub_client.py.
# GraphQL endpoint is {DATAHUB_API_URL}/api/graphql, auth is a personal
# access token as an Authorization: Bearer header. Falls back to a
# hardcoded mock catalog if unreachable/unset.
# Same pattern as CAMUNDA_BASE_URL above: this value only actually
# matters when DataHub ISN'T self-hosted - datahub/docker-compose.datahub.yml
# overrides it to http://datahub-gms:8080 whenever that overlay is
# included (deploy.sh's default local-dev behavior; run
# scripts/setup-datahub.sh afterwards to seed sample datasets into it).
# Two cases where it's live:
#   - Running the backend outside Docker against the compose-hosted
#     DataHub: http://localhost:18080 (the host-mapped GMS port).
#   - ./deploy.sh --office - DataHub is NEVER self-hosted in this mode,
#     so whatever's here IS what the app talks to. Point it at the
#     company's real DataHub instance.
DATAHUB_API_URL=http://localhost:18080
DATAHUB_API_TOKEN=

# WrenAI semantic layer (see backend/app/integrations/wrenai_client.py
# and ../wren/project) - zero-hallucination data-subject matching for
# chat.py. Default is correct for local dev (run from within backend/,
# so ../wren/project resolves to the repo-root wren/ directory); the
# Docker image overrides this to /app/wren_project via docker-compose.yml.
WREN_PROJECT_PATH=../wren/project

# Comma-separated list of origins allowed to call this API (React dev
# server, etc.)
CORS_ORIGINS=http://localhost:5173

# Comma-separated fallback approver emails used to pad a ticket's approver
# list up to 3 when the requested products' own owners don't provide that
# many (see main.py create_ticket / config.py docstring).
DEFAULT_FALLBACK_APPROVERS=compliance_director@example.com,info_sec_auditor@example.com

# Shared-secret gate on every /api/* route (see main.py's require_api_key
# and config.py's comment on this setting for exactly what it does and
# doesn't cover - added 2026-07-30 in response to a security review that
# found this API had zero authentication). Leave blank to disable (dev
# convenience default - **set a real value before any real deployment**).
# Must match the frontend's VITE_API_KEY exactly (see repo-root
# .env.example) - the frontend bakes it into its built JS at image-build
# time, so changing this here alone isn't enough once the frontend image
# has already been built.
API_KEY=
