# Copy to .env and fill in real values. Never commit the real .env.

# Postgres
DATABASE_URL=postgresql+asyncpg://dgo:dgo@localhost:5432/dgo

# On-prem LLM gateway. Assumed OpenAI-compatible (POST {LLM_BASE_URL}/chat/completions,
# stream=true) - unconfirmed against the real endpoint, adjust
# backend/app/integrations/llm_client.py if the real shape differs.
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=gemma
LLM_API_KEY=

# On-prem Camunda 8 (self-managed) Zeebe gateway. Not wired yet - see
# backend/app/integrations/camunda_client.py.
CAMUNDA_GATEWAY_ADDRESS=localhost:26500

# DataHub metadata catalog. Not wired yet - see
# backend/app/integrations/datahub_client.py. Falls back to a hardcoded
# mock catalog until this is filled in.
DATAHUB_API_URL=http://localhost:8080
DATAHUB_API_TOKEN=

# Comma-separated list of origins allowed to call this API (React dev
# server, etc.)
CORS_ORIGINS=http://localhost:5173
