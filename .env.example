# Read by `docker compose` for variable substitution in docker-compose.yml
# (distinct from backend/.env, which the backend container reads for its
# own app config). Copy to .env at the repo root and fill in a real
# password before using docker-compose.yml outside local dev.

POSTGRES_PASSWORD=dgo

# Baked into the frontend's built JS at image-build time (see
# frontend/Dockerfile's VITE_API_KEY build arg) - must match backend/.env's
# API_KEY exactly, or every frontend request gets a 401 from
# backend/app/main.py's require_api_key. Leave both blank to disable auth
# entirely (dev convenience default - see API_KEY's comment in
# backend/.env.example for what this does and doesn't protect against).
VITE_API_KEY=
