# Copy to db-secret.env (gitignored, never commit the real one) and fill
# in a real password, then:
#   kubectl create secret generic dgo-db-secret -n dgo --from-env-file=k8s/db-secret.env
# Same convention as backend/.env.example at the repo root - never
# commit the real file, only this template.
MARIADB_USER=dgo
MARIADB_PASSWORD=changeme
MARIADB_DATABASE=dgo
MARIADB_ROOT_PASSWORD=changeme
