# Copy to backend-secret.env (gitignored, never commit the real one),
# fill in real values, then:
#   kubectl create secret generic dgo-backend-secret -n dgo --from-env-file=k8s/backend-secret.env
# Same shape as backend/.env.example at the repo root, minus
# CAMUNDA_BASE_URL/DATAHUB_API_URL - those are set directly as literal
# env: values in 03-backend.yaml (pointing at the in-cluster
# camunda/datahub-gms Services), same override relationship as
# docker-compose.camunda.yml/datahub's additive backend overrides
# locally - setting them here too would just be redundant, not wrong
# (explicit env: wins over envFrom in a pod spec).

# MARIADB_PASSWORD here MUST match db-secret.env's value - DATABASE_URL
# embeds it directly (mirrors docker-compose.yml's own
# ${MARIADB_PASSWORD:-dgo} interpolation, which K8s Secrets can't do at
# apply time - there's no equivalent of a compose .env file substituting
# into another value here, so it's spelled out twice on purpose).
DATABASE_URL=mysql+asyncmy://dgo:changeme@mariadb:3306/dgo
MARIADB_USER=dgo
MARIADB_PASSWORD=changeme
MARIADB_DATABASE=dgo

# On-prem LLM gateway assumption doesn't apply here - this cluster has
# no route back to the company's internal network or your home Ollama.
# For a real working demo (not just graceful-fallback keyword matching
# every time), point this at something GKE can actually reach: a hosted
# OpenAI-compatible endpoint, or a model you deploy inside this same
# cluster. Leaving this unset means every AI-mode chat request will
# just show the LLM-unreachable fallback path - which still
# demonstrates the app's resilience design, just not the real semantic
# search this is actually meant to show off.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_SQL_MODEL=

CAMUNDA_PROCESS_DEFINITION_KEY=data-gov-approval
CAMUNDA_BASIC_AUTH_USERNAME=
CAMUNDA_BASIC_AUTH_PASSWORD=

DATAHUB_API_TOKEN=

# Update this to the frontend LoadBalancer's actual external IP/domain
# once known (kubectl get svc -n dgo frontend), then re-apply this
# secret and restart the backend Deployment - a mismatch here means the
# browser's CORS preflight to /api/* fails silently.
CORS_ORIGINS=

DEFAULT_FALLBACK_APPROVERS=compliance_director@example.com,info_sec_auditor@example.com

# Blank = auth disabled. Strongly consider setting a real value here -
# this deployment is reachable from the whole internet, not just your
# home network (see backend/.env.example's comment on what this does
# and doesn't protect against - it's a coarse shared secret, not real
# per-user auth).
API_KEY=
